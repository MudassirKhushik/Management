generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  city          String?
  primaryColor  String?  @default("#e74c3c")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  logoUrl           String?
  publicSiteEnabled Boolean @default(true)
  aboutImageUrl String?
  media         Media[]
  customDomain  String?

  cancellationPolicy String?
  noShowPolicy       String?
  importantContact   String?

  address   String?
  branches  String?
  licenseNo String?

  makkahContact  String?
  madinahContact String?
  hotlineContact String?

  bankAccounts BankAccount[]
  payments     Payment[]

  users             User[]
  packageBookings   PackageBooking[]
  packages          Package[]
  inquiries         Inquiry[]
  hotelBookings     HotelBooking[]
  transportBookings TransportBooking[]
  flightBookings    FlightBooking[]
  visaBookings      VisaBooking[]

  vendors        Vendor[]
  vendorPayments VendorPayment[]
  sequences      AgencySequence[]
}

model BankAccount {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  accountName String?
  bankName    String?
  accountNo   String?
  iban        String?
  address     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  payments Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  bookingType   String
  bookingId     String
  amount        Float
  paidOn        DateTime
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@index([bookingType, bookingId])
}

// ============================================================
// AGENCY SEQUENCE — one counter per agency per purpose. Generates short,
// human-readable, auto-incrementing, immutable codes: voucher numbers per
// booking type (H-100, T-100...), vendor codes (VN-1000), and ledger print
// numbers (LGR-100). Never reused, never user-editable.
// ============================================================
model AgencySequence {
  id         String @id @default(cuid())
  agencyId   String
  agency     Agency @relation(fields: [agencyId], references: [id])
  key        String // "hotel" | "transport" | "flight" | "visa" | "package" | "vendor" | "ledger"
  nextNumber Int    @default(100)

  @@unique([agencyId, key])
}

model Vendor {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id])
  vendorCode String?  // e.g. "VN-1000" — system-generated at creation, immutable, shown as Vendor ID
  name       String
  phone      String?
  email      String?
  country    String?
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  vendorPayments VendorPayment[]

  hotelEntries      HotelBookingEntry[]
  transportSegments TransportSegment[]
  flightSegments    FlightSegment[]
  visaEntries       VisaEntry[]

  @@unique([agencyId, name])
}

model VendorPayment {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  amount    Float
  paidOn    DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([vendorId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  createdAt    DateTime @default(now())
}

model Package {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id])
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  inquiries   Inquiry[]
}

model Inquiry {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id])
  phone       String
  peopleCount Int      @default(1)
  createdAt   DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  section   String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model PackageBooking {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  paymentStatus String? @default("Pending")
  voucherNumber String? // e.g. "FP-100" — auto, immutable, shown on Voucher/Invoice

  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  exchangeRate Float @default(1)

  includeHotels     Boolean @default(false)
  includeTransports Boolean @default(false)
  includeFlights    Boolean @default(false)
  includeVisas      Boolean @default(false)

  discount      Float    @default(0)
  vatPercent    Float    @default(0)
  paymentType   String?
  note          String?
  showBreakdown Boolean  @default(false)

  createdAt DateTime @default(now())

  hotels            HotelBookingEntry[]
  transportSegments TransportSegment[]
  flightSegments    FlightSegment[]
  visaEntries       VisaEntry[]
}

model HotelBooking {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  paymentStatus String? @default("Pending")
  voucherNumber String? // e.g. "H-100" — auto, immutable, shown on Voucher/Invoice

  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  discount      Float    @default(0)
  vatPercent    Float    @default(0)
  paymentType   String?
  note          String?
  showBreakdown Boolean  @default(false)

  exchangeRate Float

  createdAt DateTime @default(now())
  hotels    HotelBookingEntry[]
}

model HotelBookingEntry {
  id               String  @id @default(cuid())
  hotelBookingId   String?
  hotelBooking     HotelBooking?   @relation(fields: [hotelBookingId], references: [id], onDelete: Cascade)
  packageBookingId String?
  packageBooking   PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  hotelName      String
  city           String
  roomType       String
  checkIn        DateTime
  checkOut       DateTime
  rooms          Int       @default(1)
  adults         Int       @default(1)
  children       Int       @default(0)
  infants        Int       @default(0)
  mealPlan       String?
  confirmationNo String?

  buyingRatePerNight  Float @default(0)
  sellingRatePerNight Float @default(0)
}

model TransportBooking {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  paymentStatus String? @default("Pending")
  voucherNumber String? // e.g. "T-100"

  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  discount      Float    @default(0)
  vatPercent    Float    @default(0)
  paymentType   String?
  note          String?
  showBreakdown Boolean  @default(false)

  createdAt DateTime @default(now())
  segments  TransportSegment[]
}

model TransportSegment {
  id                 String  @id @default(cuid())
  transportBookingId String?
  booking            TransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  packageBookingId   String?
  packageBooking     PackageBooking?   @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  vehicle      String
  sector       String
  pickupDate   DateTime
  pickupTime   String
  qty          Int      @default(1)

  driverContact String?

  buyingCost   Float
  sellingPrice Float
}

model FlightBooking {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  paymentStatus String? @default("Pending")
  voucherNumber String? // e.g. "F-100"

  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  discount      Float    @default(0)
  vatPercent    Float    @default(0)
  paymentType   String?
  note          String?
  showBreakdown Boolean  @default(false)

  createdAt DateTime @default(now())
  segments  FlightSegment[]
}

model FlightSegment {
  id                String  @id @default(cuid())
  flightBookingId   String?
  booking           FlightBooking?  @relation(fields: [flightBookingId], references: [id], onDelete: Cascade)
  packageBookingId  String?
  packageBooking    PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  airline           String
  flightNo          String
  pnr               String?
  departureAirport  String
  arrivalAirport    String
  departureDateTime DateTime
  arrivalDateTime   DateTime
  travelClass       String?
  adults            Int      @default(1)
  children          Int      @default(0)
  infants           Int      @default(0)
  baggage           String?

  passengerNames String?

  adultBuyingPricePerLeg   Float @default(0)
  adultSellingPricePerLeg  Float @default(0)
  childBuyingPricePerLeg   Float @default(0)
  childSellingPricePerLeg  Float @default(0)
  infantBuyingPricePerLeg  Float @default(0)
  infantSellingPricePerLeg Float @default(0)
}

model VisaBooking {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])
  paymentStatus String? @default("Pending")
  voucherNumber String? // e.g. "V-100"

  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  discount      Float    @default(0)
  vatPercent    Float    @default(0)
  paymentType   String?
  note          String?
  showBreakdown Boolean  @default(false)

  createdAt DateTime @default(now())
  entries   VisaEntry[]
}

model VisaEntry {
  id               String  @id @default(cuid())
  visaBookingId    String?
  booking          VisaBooking?    @relation(fields: [visaBookingId], references: [id], onDelete: Cascade)
  packageBookingId String?
  packageBooking   PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  visaCategory   String
  applicantName  String
  passportNumber String
  companyName    String?
  processingType String?
  submissionDate DateTime?
  expiryDate     DateTime?

  buyingCost   Float
  sellingPrice Float
}