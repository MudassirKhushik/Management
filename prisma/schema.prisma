generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  city          String?
  primaryColor  String?  @default("#e74c3c")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  logoUrl           String?
  publicSiteEnabled Boolean @default(true)
  aboutImageUrl String?
  media         Media[]

  cancellationPolicy String?
  noShowPolicy       String?
  importantContact   String?

  // Round 4: Agency Info section (Settings page) — shown on Invoice/Voucher
  address   String? // shown at the bottom of Invoice/Voucher
  branches  String? // free text, one branch per line — shown under the logo/name
  licenseNo String? // shown under the REF/Date badges on Invoice/Voucher

  // --- Voucher-only contact split (Phase 1b) ---
  // These three show on the client-facing Voucher instead of
  // importantContact. importantContact is left untouched/unused on
  // documents for now rather than deleted, in case it's referenced
  // elsewhere — safe to remove later once confirmed unused.
  makkahContact  String?
  madinahContact String?
  hotlineContact String?

  bankAccounts BankAccount[]
  payments     Payment[]

  users             User[]
  packageBookings   PackageBooking[]
  packages          Package[]
  inquiries         Inquiry[]
  hotelBookings     HotelBooking[]
  transportBookings TransportBooking[]
  flightBookings    FlightBooking[]
  visaBookings      VisaBooking[]
}

model BankAccount {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  accountName String?
  bankName    String?
  accountNo   String?
  iban        String?
  address     String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  payments Payment[]
}

// ============================================================
// PAYMENT — installment/payment ledger (Phase 1d shared foundation).
// bookingType + bookingId is a loose pair (not 5 separate nullable FKs)
// so one model can attach to any of the five booking types, mirroring
// how Media.section already works.
// ============================================================
model Payment {
  id            String   @id @default(cuid())
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  bookingType   String   // "hotel" | "transport" | "flight" | "visa" | "package"
  bookingId     String
  amount        Float
  paidOn        DateTime
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@index([bookingType, bookingId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  createdAt    DateTime @default(now())
}

model Package {
  id          String    @id @default(cuid())
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id])
  title       String
  description String
  imageUrl    String?
  createdAt   DateTime  @default(now())
  inquiries   Inquiry[]
}

model Inquiry {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id])
  phone       String
  peopleCount Int      @default(1)
  createdAt   DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  section   String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================================
// FULL PACKAGE BOOKING — the combined wizard (roadmap item 6)
// One global header + footer. Section checkboxes decide which
// entry types get rows. Each entry type below can belong to
// EITHER a standalone booking OR a PackageBooking (never both).
// ============================================================
model PackageBooking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  vendorName String?
  paymentStatus String? @default("Pending")

  // --- Global Header (own copy) ---
  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  // Hotel rows inside a package are priced in SAR like standalone hotel
  // bookings; every other section is already PKR. This rate converts the
  // hotel lines so one PKR total can be summed across all sections.
  // Defaulted to 1 so adding it can never break existing rows (see §2).
  exchangeRate Float @default(1)

  // --- Section toggles ---
  includeHotels     Boolean @default(false)
  includeTransports Boolean @default(false)
  includeFlights    Boolean @default(false)
  includeVisas      Boolean @default(false)

  discount    Float    @default(0)
  vatPercent  Float    @default(0)
  paymentType String?
  note        String?

  createdAt DateTime @default(now())

  hotels            HotelBookingEntry[]
  transportSegments TransportSegment[]
  flightSegments    FlightSegment[]
  visaEntries       VisaEntry[]
}

// ============================================================
// HOTEL BOOKING
// ============================================================
model HotelBooking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  vendorName String?
  paymentStatus String? @default("Pending")
  

  // --- Global Header (own copy) ---
  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  // --- Pricing & Profit Module inputs ---
  discount    Float    @default(0)
  vatPercent  Float    @default(0)
  paymentType String?
  note        String?

  // Item 5 (round 3): required numeric exchange rate — hotel currency
  // defaults to SAR, but the agency's internal profit/revenue reporting
  // needs a PKR-converted figure. This rate does that conversion. Required
  // because there's no live data yet to worry about backfilling.
  exchangeRate Float

  createdAt DateTime @default(now())
  hotels    HotelBookingEntry[]
}

model HotelBookingEntry {
  id             String   @id @default(cuid())

  hotelBookingId String?
  hotelBooking   HotelBooking?   @relation(fields: [hotelBookingId], references: [id], onDelete: Cascade)
  packageBookingId String?
  packageBooking PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  hotelName      String
  city           String
  roomType       String    // Single, Double, Triple, Quad, Quint Suite, Family Room, Sharing
  checkIn        DateTime
  checkOut       DateTime
  rooms          Int       @default(1)
  adults         Int       @default(1)
  children       Int       @default(0)
  infants        Int       @default(0)
  mealPlan       String?   // RO, BB, HB, FB
  confirmationNo String?

  // --- Phase 1a: separate Adult/Child pricing, per person per night.
  // Infants remain headcount-only, no pricing impact (per spec).
  // Replaces the old flat buyingCostPerNight/sellingPricePerNight —
  // see migration/001_hotel_adult_child_pricing.sql before deploying.
  adultBuyingPricePerNight  Float @default(0)
  adultSellingPricePerNight Float @default(0)
  childBuyingPricePerNight  Float @default(0)
  childSellingPricePerNight Float @default(0)
  // nights & line totals are CALCULATED on screen/PDF, never stored
}

// ============================================================
// TRANSPORT BOOKING
// ============================================================
model TransportBooking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  vendorName String?
  paymentStatus String? @default("Pending")

  // --- Global Header (own copy) ---
  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  // --- Pricing & Profit Module inputs ---
  discount    Float    @default(0)
  vatPercent  Float    @default(0)
  paymentType String?
  note        String?

  createdAt DateTime @default(now())
  segments  TransportSegment[]
}

model TransportSegment {
  id                  String   @id @default(cuid())

  transportBookingId  String?
  booking             TransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  packageBookingId    String?
  packageBooking      PackageBooking?   @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  vehicle      String
  sector       String
  pickupDate   DateTime
  pickupTime   String
  qty          Int      @default(1)

  driverContact String? // voucher-only — client calls the driver directly

  buyingCost   Float
  sellingPrice Float
}

// ============================================================
// FLIGHT BOOKING
// ============================================================
model FlightBooking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  vendorName String?
  paymentStatus String? @default("Pending")
  

  // --- Global Header (own copy) ---
  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  // --- Pricing & Profit Module inputs ---
  discount    Float    @default(0)
  vatPercent  Float    @default(0)
  paymentType String?
  note        String?

  createdAt DateTime @default(now())
  segments  FlightSegment[]
}

model FlightSegment {
  id                String   @id @default(cuid())

  flightBookingId   String?
  booking           FlightBooking?  @relation(fields: [flightBookingId], references: [id], onDelete: Cascade)
  packageBookingId  String?
  packageBooking    PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  airline           String
  flightNo          String
  pnr               String?
  departureAirport  String
  arrivalAirport    String
  departureDateTime DateTime
  arrivalDateTime   DateTime
  travelClass       String?
  adults            Int      @default(1)
  children          Int      @default(0)
  infants           Int      @default(0)
  baggage           String?

  // One name per line. Kept as free text rather than its own table — the
  // list is only ever displayed, never queried or joined on.
  passengerNames String?

  // Per-passenger, per-leg. Infants DO get their own price here, unlike
  // hotel where they're headcount-only.
  adultBuyingPricePerLeg   Float @default(0)
  adultSellingPricePerLeg  Float @default(0)
  childBuyingPricePerLeg   Float @default(0)
  childSellingPricePerLeg  Float @default(0)
  infantBuyingPricePerLeg  Float @default(0)
  infantSellingPricePerLeg Float @default(0)
}

// ============================================================
// VISA BOOKING
// ============================================================
model VisaBooking {
  id          String   @id @default(cuid())
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  vendorName String?
  paymentStatus String? @default("Pending")

  // --- Global Header (own copy) ---
  agentName   String
  guestName   String
  nationality String
  mobileNo    String
  referenceNo String?
  currency    String   @default("PKR")

  // --- Pricing & Profit Module inputs ---
  discount    Float    @default(0)
  vatPercent  Float    @default(0)
  paymentType String?
  note        String?

  createdAt DateTime @default(now())
  entries   VisaEntry[]
}

model VisaEntry {
  id                String   @id @default(cuid())

  visaBookingId     String?
  booking           VisaBooking?    @relation(fields: [visaBookingId], references: [id], onDelete: Cascade)
  packageBookingId  String?
  packageBooking    PackageBooking? @relation(fields: [packageBookingId], references: [id], onDelete: Cascade)

  visaCategory    String   // e.g. Saudi Umrah, UK Tourist, Schengen Business
  applicantName   String
  passportNumber  String
  companyName     String?  // Phase 4a — applicant's employer. Optional, so
                           // this is safe on a table with live data (see §2).
  processingType  String?  // Normal, Urgent, Express
  submissionDate  DateTime?
  expiryDate      DateTime?

  buyingCost   Float
  sellingPrice Float
}
